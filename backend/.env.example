# Variables d'environnement - SMALIM Backend
# Copier ce fichier en .env et remplir les valeurs

# Serveur
PORT=5000
NODE_ENV=development

# Base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=votre_mot_de_passe
DB_NAME=smalim_db

# JWT
JWT_SECRET=votre_secret_jwt_tres_long_et_securise_ici
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=votre_refresh_secret_jwt

# Clé de chiffrement des secrets stockés en base (mot de passe SMTP saisi
# dans le back-office). À défaut, JWT_SECRET est utilisé. La changer oblige
# à ressaisir ces secrets.
SETTINGS_SECRET=une_autre_cle_longue_et_aleatoire
JWT_REFRESH_EXPIRES_IN=30d

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:5173

# ── Email ────────────────────────────────────────────────────
# Fournisseur : smtp | gmail | sendgrid
EMAIL_PROVIDER=smtp

# Expéditeur affiché dans les emails
EMAIL_FROM=noreply@smalim.sn
EMAIL_FROM_NAME=SMALIM

# SMTP générique
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre@email.com
SMTP_PASS=votre_mot_de_passe_app

# SendGrid (si EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx

# ── Paiement ─────────────────────────────────────────────────
# URL publique du backend : sert à construire l'URL de notification
# transmise aux prestataires (doit être joignable depuis Internet en prod).
BACKEND_URL=http://localhost:5000

# Wave Sénégal — https://docs.wave.com/business
# Sans WAVE_API_KEY, le paiement Wave bascule en simulation (hors production).
WAVE_API_KEY=
WAVE_WEBHOOK_SECRET=
WAVE_API_URL=https://api.wave.com/v1

# Orange Money Sénégal (WebPay) — https://developer.orange.com/apis/om-webpay
# Les trois valeurs sont requises ensemble ; sinon simulation (hors production).
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_AUTH_URL=https://api.orange.com/oauth/v3/token
ORANGE_MONEY_API_URL=https://api.orange.com/orange-money-webpay/dev/v1

STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# ── Upload fichiers ──────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
